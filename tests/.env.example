# Test Environment Variables
#
# This is a template file. To use it:
# 1. Copy this file to .env.local (gitignored)
# 2. Replace placeholder values with your actual credentials
# 3. Source it before running tests: source .env.local
#
# SECURITY WARNING: Never commit .env.local or any file containing real API keys!

# ZeroClaw API Keys
ZEROCLAW_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Aliyun PAI-EAS Configuration (if using custom endpoint)
ALIYUN_PAI_BASE_URL=http://your-instance-id.cn-hangzhou.pai-eas.aliyuncs.com/api/predict/your-deployment/v1
ALIYUN_PAI_API_KEY=your-base64-encoded-key-here

# Test Configuration
TEST_API_TOKEN=test-token-here
ZTM_API_TOKEN=enjoy-party

# Optional: Override default test ports
# ALICE_PORT=7781
# BOB_PORT=7782
# HUB_PORT=18888
